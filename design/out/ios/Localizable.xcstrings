    "help_exfat": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Některé telefony s Androidem 8 až 10 flashku nepřečtou. Nouzové příručky ale najdete přímo v aplikaci a zbytek otevřete v počítači."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Niektoré telefóny s Androidom 8 až 10 USB kľúč neprečítajú. Núdzové príručky však nájdete priamo v aplikácii a zvyšok otvoríte v počítači."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some phones with Android 8 to 10 can't read the drive. The emergency guides are built into the app, and a computer opens the rest."
          }
        }
