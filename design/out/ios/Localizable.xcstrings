    "library_index_offer_body": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Najde články podle kteréhokoli slova v názvu. Příprava trvá asi 10 minut a zabere 220 MB. Telefon se při tom zahřeje, nechte ho v nabíječce a aplikaci otevřenou. Číst můžete i mezitím."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nájde články podľa ktoréhokoľvek slova v názve. Príprava trvá asi 10 minút a zaberie 220 MB. Telefón sa pri tom zahreje, nechajte ho v nabíjačke a aplikáciu otvorenú. Čítať môžete aj medzitým."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finds articles by any word in the title. Preparing takes about 10 minutes and 220 MB. The phone gets warm, so keep it on the charger and the app open. You can read in the meantime."
          }
        }
      }
    },
