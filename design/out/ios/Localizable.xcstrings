    "status_drive_connected": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Flashka je zapojená."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "USB kľúč je zapojený."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The drive is plugged in."
          }
        }
      }
    },
    "connect_title": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapojte flashku Offlinka"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapojte USB kľúč Offlinka"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plug in your Offlinka drive"
          }
        }
      }
    },
    "connect_body": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikace čte Wikipedii, mapy a příručky přímo z flashky. Nic se nekopíruje a internet nepotřebujete."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikácia číta Wikipédiu, mapy a príručky priamo z USB kľúča. Nič sa nekopíruje a internet nepotrebujete."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app reads Wikipedia, maps and guides straight from the drive. Nothing is copied and you need no internet."
          }
        }
      }
    },
    "connect_step_plug": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zasuňte flashku do konektoru USB-C."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zasuňte USB kľúč do konektora USB-C."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plug the drive into the USB-C port."
          }
        }
      }
    },
    "connect_step_pick_android": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V dalším okně klepněte dole na „Použít tuto složku“ a potom na „Povolit“. Aplikace z flashky jen čte."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "V ďalšom okne ťuknite dole na „Použiť tento priečinok“ a potom na „Povoliť“. Aplikácia z USB kľúča len číta."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the next screen, tap “Use this folder” at the bottom, then “Allow”. The app only reads the drive."
          }
        }
      }
    },
    "connect_step_pick_ios": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V dalším okně vyberte OFFLINKA a klepněte na Otevřít."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "V ďalšom okne vyberte OFFLINKA a ťuknite na Otvoriť."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the next screen, pick OFFLINKA and tap Open."
          }
        }
      }
    },
    "connect_button": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vybrat flashku"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vybrať USB kľúč"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose drive"
          }
        }
      }
    },
    "connect_remember": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikace si flashku zapamatuje. Příště ji stačí zapojit."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikácia si USB kľúč zapamätá. Nabudúce ho stačí zapojiť."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app remembers the drive. Next time, just plug it in."
          }
        }
      }
    },
    "connect_help_link": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Flashka se neukazuje?"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "USB kľúč sa nezobrazuje?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drive not showing up?"
          }
        }
      }
    },
    "connect_searching": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hledám knihy na flashce…"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hľadám knihy na USB kľúči…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Looking for books on the drive…"
          }
        }
      }
    },
    "connect_err_notfound_title": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Flashku nevidím"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "USB kľúč nevidím"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No drive found"
          }
        }
      }
    },
    "connect_err_notfound_body": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zasuňte ji celou do konektoru a počkejte pár vteřin. Pomůže i vytáhnout ji a zapojit znovu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zasuňte ho celý do konektora a počkajte pár sekúnd. Pomôže aj vytiahnuť ho a zapojiť znova."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Push it all the way into the port and wait a few seconds. Unplugging and plugging it back in also helps."
          }
        }
      }
    },
    "connect_err_wrongfolder_title": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tady knihy nejsou"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu knihy nie sú"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No books in this folder"
          }
        }
      }
    },
    "connect_err_wrongfolder_body": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte složku OFFLINKA, nebo v ní složku Knihovna."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte priečinok OFFLINKA alebo v ňom priečinok Knihovna."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick the OFFLINKA folder, or the Knihovna folder inside it."
          }
        }
      }
    },
    "connect_err_noaccess_title": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nemám přístup"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nemám prístup"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No access"
          }
        }
      }
    },
    "connect_err_noaccess_body": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepněte na „Vybrat znovu“ a v dalším okně na „Povolit“."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ťuknite na „Vybrať znova“ a v ďalšom okne na „Povoliť“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap “Choose again”, then “Allow” on the next screen."
          }
        }
      }
    },
    "connect_pick_again": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vybrat znovu"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vybrať znova"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose again"
          }
        }
      }
    },
    "help_title": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když se flashka neukazuje"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak sa USB kľúč nezobrazuje"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the drive doesn't show up"
          }
        }
      }
    },
    "help_1": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zasuňte flashku až na doraz. Konektor USB-C jde zasunout oběma stranami."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zasuňte USB kľúč až na doraz. Konektor USB-C sa dá zasunúť oboma stranami."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Push the drive all the way in. USB-C fits either way up."
          }
        }
      }
    },
    "help_2": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vytáhněte ji, počkejte pár vteřin a zapojte znovu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vytiahnite ho, počkajte pár sekúnd a zapojte znova."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unplug it, wait a few seconds and plug it back in."
          }
        }
      }
    },
    "help_3_android": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefony Oppo, Realme a Vivo mají v nastavení přepínač OTG. Zapněte ho, jinak flashku nevidí."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefóny Oppo, Realme a Vivo majú v nastaveniach prepínač OTG. Zapnite ho, inak USB kľúč nevidia."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppo, Realme and Vivo phones have an OTG switch in settings. Turn it on, or the phone won't see the drive."
          }
        }
      }
    },
    "help_4_ios": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 14 a starší mají konektor Lightning. Do něj flashka nepasuje."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 14 a starší majú konektor Lightning. USB kľúč doň nezapojíte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 14 and older have a Lightning port. The drive doesn't fit it."
          }
        }
      }
    },
    "help_5": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Silný obal telefonu někdy nedovolí konektor zasunout. Zkuste to bez obalu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hrubý obal telefónu niekedy nedovolí konektor zasunúť. Skúste to bez obalu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A thick phone case can stop the plug going in. Try without it."
          }
        }
      }
    },
    "unplugged_title": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Flashka je odpojená"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "USB kľúč je odpojený"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The drive is unplugged"
          }
        }
      }
    },
    "unplugged_body": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapojte ji znovu a budete pokračovat tam, kde jste skončili."
          }
        },
        "sk": {
          "stringUnit": {
