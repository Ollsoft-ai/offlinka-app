    <string name="connect_title">Plug in your Offlinka drive</string>
    <string name="connect_body">The app reads Wikipedia, maps and guides straight from the drive. Nothing is copied and you need no internet.</string>
    <string name="connect_step_plug">Plug the drive into the USB-C port.</string>
    <string name="connect_step_pick_android">On the next screen, tap “Use this folder” at the bottom, then “Allow”. The app only reads the drive.</string>
    <string name="connect_step_pick_ios">In the next screen, pick OFFLINKA and tap Open.</string>
    <string name="connect_button">Choose drive</string>
    <string name="connect_remember">The app remembers the drive. Next time, just plug it in.</string>
    <string name="connect_help_link">Drive not showing up?</string>
    <string name="connect_searching">Looking for books on the drive…</string>
    <string name="connect_err_notfound_title">No drive found</string>
    <string name="connect_err_notfound_body">Push it all the way into the port and wait a few seconds. Unplugging and plugging it back in also helps.</string>
    <string name="connect_err_wrongfolder_title">No books in this folder</string>
    <string name="connect_err_wrongfolder_body">Pick the drive\'s top folder, OFFLINKA, not a folder inside it.</string>
    <string name="connect_err_noaccess_title">No access</string>
    <string name="connect_err_noaccess_body">Tap Pick again, then “Allow” on the next screen.</string>
    <string name="connect_pick_again">Choose again</string>
    <string name="help_title">If the drive doesn\'t show up</string>
    <string name="help_1">Push the drive all the way in. USB-C fits either way up.</string>
    <string name="help_2">Unplug it, wait a few seconds and plug it back in.</string>
    <string name="help_3_android">Oppo, Realme and Vivo phones have an OTG switch in settings. Turn it on, or the phone won\'t see the drive.</string>
    <string name="help_4_ios">iPhone 14 and older have a Lightning port. The drive doesn\'t fit it.</string>
    <string name="help_5">A thick phone case can stop the plug going in. Try without it.</string>
    <string name="unplugged_title">The drive is unplugged</string>
    <string name="unplugged_body">Plug it back in to continue where you left off.</string>
