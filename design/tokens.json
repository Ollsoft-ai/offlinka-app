  "bookTones": {
    "_note": "Icon box colours per book family [background, foreground]. Families: wiki = Wikipedias, maps, aid = guides + medicine, books = Wikibooks/Wikisource/Wikiquote/Wiktionary/Wikiversity, games, travel = Wikivoyage.",
    "light": {
      "wiki": ["#E9DFC8", "#1F3D2F"],
      "maps": ["#DCE6D3", "#2F5642"],
      "aid": ["#F6D8CE", "#B4321F"],
      "books": ["#EFDDBF", "#7A4B12"],
      "games": ["#FBDCC8", "#A33F05"],
      "travel": ["#D8E2DA", "#3E5F55"]
    },
    "dark": {
      "wiki": ["#2A3A2F", "#E9DFC8"],
      "maps": ["#22392B", "#B5CFA2"],
      "aid": ["#3B211B", "#F0A08F"],
      "books": ["#33291A", "#E3C08E"],
      "games": ["#3A2416", "#FFB98C"],
      "travel": ["#20322C", "#A9C7BC"]
    }
  },
  "font": {
    "text": { "family": "Archivo", "files": { "400": "archivo_regular.ttf", "600": "archivo_semibold.ttf", "700": "archivo_bold.ttf" }, "postscript": { "400": "Archivo-Regular", "600": "Archivo-SemiBold", "700": "Archivo-Bold" } },
    "display": { "family": "Archivo Expanded", "files": { "800": "archivo_expanded_extrabold.ttf" }, "postscript": { "800": "ArchivoExpanded-ExtraBold" } }
  },
  "type": {
    "_note": "size and lineHeight in sp (Android) = pt (iOS) = px (CSS). tracking in em. relativeTo = the iOS Dynamic Type style it scales with.",
    "display":     { "font": "display", "weight": 800, "size": 30, "lineHeight": 34, "tracking": -0.015, "relativeTo": "largeTitle" },
    "headline":    { "font": "display", "weight": 800, "size": 24, "lineHeight": 29, "tracking": -0.01, "relativeTo": "title" },
    "title":       { "font": "display", "weight": 800, "size": 19, "lineHeight": 24, "tracking": -0.01, "relativeTo": "title3" },
    "titleSmall":  { "font": "display", "weight": 800, "size": 16, "lineHeight": 21, "tracking": -0.005, "relativeTo": "headline" },
    "button":      { "font": "display", "weight": 800, "size": 17, "lineHeight": 22, "tracking": -0.005, "relativeTo": "headline" },
    "subhead":     { "font": "text", "weight": 700, "size": 17, "lineHeight": 23, "tracking": 0, "relativeTo": "headline" },
    "body":        { "font": "text", "weight": 400, "size": 17, "lineHeight": 25, "tracking": 0, "relativeTo": "body" },
    "bodyStrong":  { "font": "text", "weight": 600, "size": 17, "lineHeight": 25, "tracking": 0, "relativeTo": "body" },
    "bodySmall":   { "font": "text", "weight": 400, "size": 15, "lineHeight": 21, "tracking": 0, "relativeTo": "subheadline" },
    "label":       { "font": "text", "weight": 600, "size": 15, "lineHeight": 20, "tracking": 0, "relativeTo": "subheadline" },
    "labelSmall":  { "font": "text", "weight": 600, "size": 13, "lineHeight": 17, "tracking": 0.01, "relativeTo": "footnote" },
    "caption":     { "font": "text", "weight": 400, "size": 13, "lineHeight": 18, "tracking": 0, "relativeTo": "caption" },
    "searchInput": { "font": "text", "weight": 600, "size": 18, "lineHeight": 24, "tracking": 0, "relativeTo": "body" }
  },
  "space": { "xxs": 2, "xs": 4, "s": 8, "m": 12, "l": 16, "xl": 20, "xxl": 24, "xxxl": 32, "huge": 48 },
  "radius": { "xs": 3, "s": 6, "m": 8, "l": 12, "pill": 999 },
  "size": {
    "gutter": 16,
    "touch": 48,
    "icon": 24,
    "iconSmall": 20,
    "bookIconBox": 44,
    "bookIconBoxSmall": 36,
    "bookIcon": 26,
    "appBar": 56,
    "bottomBar": 64,
    "searchField": 56,
    "button": 52,
    "buttonSmall": 40,
    "chip": 36,
    "listRow": 64,
    "outline": 1.5,
    "outlineSelected": 2,
    "hairline": 1,
    "ridge": 28,
    "readerMaxWidth": 680
  },
  "elevation": {
    "_note": "Hard offset shadows, no blur (brand). Draw an offset copy of the shape behind it. Compose: Modifier.drawBehind; SwiftUI: .shadow(color:, radius: 0, x:, y:).",
    "card":     { "x": 4, "y": 5, "color": "shadow" },
    "raised":   { "x": 5, "y": 6, "color": "shadowStrong" },
    "selected": { "x": 4, "y": 5, "color": "shadowSelected" },
    "button":   { "x": 0, "y": 4, "color": "primaryEdge", "pressedY": 2 }
  },
  "motion": {
    "_note": "Calm. Only respond to the user's own action. Respect reduce motion (then 0 ms).",
    "fast": 120,
    "standard": 200,
    "slow": 280,
    "easing": [0.2, 0.7, 0.2, 1]
  }
}
